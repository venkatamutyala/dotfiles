{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SHELL": "/bin/bash"
  },
  "theme": "dark",
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "autoMemoryDirectory": "~/.agent-memory/memory",
  "permissions": {
    "allow": [
      "Read(~/.agent-memory/**)",
      "Edit(~/.agent-memory/memory/**)",
      "Edit(~/.agent-memory/projects/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-memory-sync.sh start",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-memory-sync.sh push"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-memory-sync.sh push"
          }
        ]
      }
    ]
  }
}
