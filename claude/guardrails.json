{
  "permissions": {
    "deny": [
      "Bash(kubectl get secret *)",
      "Bash(kubectl get secrets *)",
      "Bash(kubectl describe secret *)",
      "Bash(kubectl describe secrets *)",
      "Bash(gh auth token *)",
      "Bash(gh auth status --show-token *)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(kubectl get configmap *)",
      "Bash(kubectl get configmaps *)",
      "Bash(kubectl get cm *)",
      "Bash(kubectl describe configmap *)",
      "Bash(kubectl describe configmaps *)",
      "Bash(kubectl describe cm *)",
      "Bash(kubectl config view *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-host-install.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "~/.claude/hooks/gitleaks-guard.sh",
            "statusMessage": "Scanning for secrets"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "~/.claude/hooks/gitleaks-guard.sh",
            "statusMessage": "Scanning for secrets"
          }
        ]
      }
    ]
  }
}
